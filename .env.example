HOST=0.0.0.0
PORT=8080
NODE_ENV=production
PUBLIC_BASE_URL=https://mods.example.com
PUBLIC_CDN_URL=https://cdn.example.com
# origin = Cloudflare 代理源站 /api/v1/public/artifacts/:sha
# r2 = 自定义域名直出 R2，例如 https://cdn.example.com/objects/:sha
CDN_STYLE=origin
CF_ZONE_ID=
CF_API_TOKEN=
PUBLIC_LAUNCHER_URL=https://mods.example.com
DATA_DIR=./data
ADMIN_TOKEN=change-this-long-random-token
# Defaults to false: ADMIN_TOKEN stops authenticating after the first user registers.
ALLOW_BOOTSTRAP_ADMIN=false
# Production requires SIGNING_PRIVATE_KEY or SIGNING_SERVICE_URL. Never rely on the auto-generated dev key.
SIGNING_PRIVATE_KEY=
SIGNING_SERVICE_URL=
SIGNING_SERVICE_TOKEN=
MANIFEST_TTL_DAYS=90
# Leave empty to keep the JSON single-node store. Example: postgres://modplatform:secret@postgres:5432/modplatform
DATABASE_URL=
MAX_ARTIFACT_BYTES=2147483648
MAX_DIAGNOSTIC_BYTES=262144
DIAGNOSTIC_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
LOG_RETENTION_DAYS=14
FORCE_HTTPS=true
TRUSTED_PROXY=true
ADMIN_HOST=
REQUIRE_REVIEW=true
CRASH_RATE_BLOCK_THRESHOLD=0.35
CRASH_RATE_MIN_SAMPLES=8
ALERT_WEBHOOK_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=objects/
POSTGRES_PASSWORD=change-this-postgres-password
# Optional local virus scan binary. If missing, scans are skipped.
# CLAMSCAN_PATH=clamscan
