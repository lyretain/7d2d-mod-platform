HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATA_DIR=./data
ADMIN_TOKEN=change-this-long-random-token
# Defaults to false: ADMIN_TOKEN stops authenticating after the first user registers.
ALLOW_BOOTSTRAP_ADMIN=false
# Production: provide a base64 PKCS#8 Ed25519 private key and do not use the dev key file.
# SIGNING_PRIVATE_KEY=
MAX_ARTIFACT_BYTES=2147483648
MAX_DIAGNOSTIC_BYTES=262144
DIAGNOSTIC_RETENTION_DAYS=30
