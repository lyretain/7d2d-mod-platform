# 复制到宝塔「项目配置 → 环境变量」。API 不会自动读仓库里的 .env。
# 单机本机磁盘：S3 全部留空。不要用 MySQL。

HOST=127.0.0.1
PORT=8080
NODE_ENV=production

PUBLIC_BASE_URL=https://mods.aic.la
PUBLIC_LAUNCHER_URL=https://mods.aic.la
PUBLIC_CDN_URL=https://mods.aic.la
CDN_STYLE=origin

DATA_DIR=/www/mod-platform-data
DATABASE_URL=postgres://modplatform:请改成强密码@127.0.0.1:5432/modplatform

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PREFIX=objects/

ADMIN_TOKEN=请改成至少16位的随机令牌
ALLOW_BOOTSTRAP_ADMIN=false
FORCE_HTTPS=true
TRUSTED_PROXY=true

# openssl pkey -in /www/mod-platform-data/signing.pk8 -outform DER | base64 -w 0
SIGNING_PRIVATE_KEY=
